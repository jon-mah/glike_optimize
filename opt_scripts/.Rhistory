params_long <- params %>%
select(
kappa,
N_anc,
N_ceu,
N_chb,
N_ooa,
N_yri,
gr_ceu,
gr_chb,
t1,
t2,
t3
) %>%
pivot_longer(
cols = -kappa,
names_to = "parameter",
values_to = "value"
)
ggplot(params_long, aes(x = kappa, y = value)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(
width = 0.1,
alpha = 0.5
) +
facet_wrap(
~ parameter,
scales = "free_y",
ncol = 2
) +
labs(
x = "κ",
y = "Parameter value",
title = "CMA-ES Parameter Estimates across κ Values"
) +
theme_classic()
