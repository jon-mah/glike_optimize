)
plots <- list()
for (parameter in parameter_names) {
plots[[parameter]] <- ggplot(
params,
aes(
x = kappa,
y = .data[[parameter]]
)
) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(
width = 0.1,
alpha = 0.5
) +
geom_hline(
yintercept = true_values_3G09[parameter],
linetype = "dashed"
) +
labs(
x = "κ",
y = parameter,
title = paste("CMA-ES estimates of", parameter)
) +
theme_classic()
}
