labels = c("κ = 10,000", "κ = 25,000", "κ = 50,000")
)
)
# Read and combine
benchmarks <- map_dfr(benchmark_files, function(f) {
# Extract kappa from filename
kappa <- str_extract(f, "(?<=kappa_)\\d+") |> as.integer()
read_csv(f, show_col_types = FALSE) %>%
mutate(kappa = kappa)
})
